# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files (from Terraform crashes)
crash.log

# Local .terraform directories
.terraform/

# CLI configuration files
.terraformrc
terraform.rc

# Lock file, generated by Terraform, that stores the current state of the providers used in the project
.terraform.lock.hcl

# Ignore files generated by plan command
*.tfplan
.vscode/